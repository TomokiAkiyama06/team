# ============================================================
# classbot 設定ファイル（.env.example をコピーして .env を作成）
#   cp .env.example .env && chmod 600 .env
# .env は絶対に Git にコミットしないこと（.gitignore 済み）
# ============================================================

# ---------- Slack ----------
# Bot User OAuth Token（xoxb-...）
SLACK_BOT_TOKEN=
# App-Level Token（xapp-...、スコープ connections:write）
SLACK_APP_TOKEN=
# ボットが応答する唯一のチャンネルID（例: C0123456789）
SLACK_CHANNEL_ID=
# 管理者の Slack ユーザーID（カンマ区切り、例: U0123,U0456）
SLACK_ADMIN_USER_IDS=
# （任意）ワークスペースID（T...）。設定すると他組織（Slack Connect）のユーザーを無視する
SLACK_TEAM_ID=
# 利用者を限定するか。true にすると、管理者・下の SLACK_ALLOWED_USER_IDS・管理者が Slack で
# 「@ClaudeBot 利用者追加 @ユーザー」と登録した人だけが使える（チャンネルを公開にする場合に推奨）。
# 登録されていない人がメンションすると本人にだけ案内を表示し、AI は呼ばない（費用がかからない）
SLACK_RESTRICT_USERS=false
# （任意）最初から利用を許可する Slack ユーザーID（カンマ区切り）。Slack の「利用者追加」でも登録できる
SLACK_ALLOWED_USER_IDS=

# ---------- Anthropic Claude API ----------
ANTHROPIC_API_KEY=
# 使用モデルID（既定: Claude Sonnet 5.5 = 入力 $2 / 出力 $10 per 100万トークン）
# 他の選択肢: claude-opus-5-5（高精度・約2倍の単価） / claude-haiku-5-5（最安・精度は下がる）
# ※ config/pricing.toml に料金が登録されたモデルでないと起動しません
CLAUDE_MODEL=claude-sonnet-5-5
# 思考の深さ（low | medium | high | xhigh | max）。高いほど出力トークン＝費用が増える
# Sonnet 5.5 の API 既定は high。授業Q&Aでは medium を推奨（費用を抑えたい場合は low）
CLAUDE_EFFORT=medium
# 1回の回答の最大出力トークン（思考分を含む。予算予約の上限見積もりにも使用）
CLAUDE_MAX_TOKENS=8000
# API タイムアウト（秒）と SDK の自動リトライ回数（指数バックオフ）
CLAUDE_TIMEOUT_SEC=120
CLAUDE_MAX_RETRIES=3
# 安全分類器による拒否時のサーバー側フォールバック（beta・Claude API のみ）。既定は無効。
# 有効にすると拒否された試行と代替モデルの試行の両方が課金され得るため、予算予約は約2倍になります。
# 対応モデル: claude-sonnet-5-5 / claude-opus-5-5 / claude-opus-5 / claude-fable-5-1（他は自動で無効）
CLAUDE_REFUSAL_FALLBACK=false
# システムプロンプトのプロンプトキャッシュ
CLAUDE_PROMPT_CACHE=true

# ---------- コスト管理 ----------
# 学生1人あたりの1日のリクエスト上限
DAILY_REQUEST_LIMIT_PER_USER=30
# 月額予算（USD、このボットの利用分の推定値に対する上限）
MONTHLY_BUDGET_USD=20
# Claude API の同時リクエスト数
MAX_CONCURRENT_REQUESTS=3
# 管理者を日次上限の対象外にするか
ADMINS_EXEMPT_FROM_DAILY_LIMIT=true
# 1ユーザーが同時に待機できる質問数
MAX_PENDING_PER_USER=2
# 入力トークン数の保守的見積もり（1文字あたりのトークン数）
TOKEN_ESTIMATE_PER_CHAR=1.2
# 料金テーブル（モデル別単価）
PRICING_FILE=config/pricing.toml
# 日次・月次集計のタイムゾーン
TIMEZONE=Asia/Tokyo

# ---------- パス（Docker ではデフォルトのままでよい） ----------
MATERIALS_DIR=materials
DATA_DIR=data
SYSTEM_PROMPT_FILE=config/system_prompt.md

# ---------- 資料処理 ----------
# 1ファイルの最大サイズ（MB）
MAX_FILE_SIZE_MB=30
# PDF/スライドの最大ページ数
MAX_PAGES=2000
# 1資料から抽出する最大文字数
MAX_EXTRACTED_CHARS=5000000
# 抽出処理（子プロセス）のタイムアウト秒・メモリ上限MB
EXTRACT_TIMEOUT_SEC=300
EXTRACT_MAX_MEMORY_MB=1536
# PPTX/DOCX（ZIP形式）の ZIP 爆弾対策
ZIP_MAX_UNCOMPRESSED_MB=300
ZIP_MAX_ENTRIES=5000
ZIP_MAX_RATIO=200
# チャンクサイズと重なり（文字数）
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=120
# PPTX の発表者ノートを検索対象に含めるか（教員用メモの流出防止のため既定 false）
PPTX_INCLUDE_NOTES=false
# スキャンPDFの OCR（ローカル Tesseract。Docker は INSTALL_OCR=true でビルド）
OCR_ENABLED=false
OCR_LANGUAGE=jpn+eng
# materials/ の定期再照合間隔（秒）・ファイル書き込み完了とみなす待ち時間（秒）
SCAN_INTERVAL_SEC=300
FILE_STABLE_SEC=5
# ファイル変更の即時検知（watchdog）
USE_WATCHDOG=true

# ---------- 検索・会話 ----------
# キーワード検索で AI に渡す断片（ほぼ1ページ・最大800文字）の最大数・1資料あたりの最大数・合計文字数。
# 「これまでの課題を全部」のように複数回の資料をまたぐ質問は、TOP_K が授業回数より少ないと取りこぼす
# （一致率 15% 未満の断片は渡さないため、上限を上げても無関係なページは増えにくい）
SEARCH_TOP_K=30
SEARCH_MAX_PER_MATERIAL=10
SEARCH_CONTEXT_MAX_CHARS=40000
# 質問が指している資料（そのスレッドで登録した資料、ファイル名や「第N回」で指定された資料）の
# 全文を渡す上限（文字数、検索結果とは別枠）。超える資料は質問に近い部分を上限まで渡す。
# 100000 文字 ≒ 最大 約10万入力トークン ≒ Sonnet 5.5 で 1 回あたり最大 約 $0.20〜0.25
FOCUS_MATERIAL_MAX_CHARS=100000
# スレッドの会話履歴として渡す最大ターン数（質問・回答それぞれ1ターン）と文字数
HISTORY_MAX_TURNS=20
HISTORY_MAX_CHARS=30000
# 1つの質問の最大文字数（エラーログを貼る場合に備えて長め）
QUESTION_MAX_CHARS=8000

# ---------- 画像入力（学生の画像付き質問） ----------
# 画像付き質問を受け付けるか（false にすると画像付きの投稿には案内を返す）
IMAGE_INPUT_ENABLED=true
# 1つの投稿で受け付ける画像の枚数（超えると受付時に案内して API は呼ばない）
IMAGE_MAX_PER_MESSAGE=4
# 1回の API 呼び出しに含める画像の上限（スレッド履歴の画像を含む。最大 20）
IMAGE_MAX_PER_REQUEST=6
# Slack から取得する元画像の最大サイズ（MB）
IMAGE_MAX_FILE_MB=10
# 展開前に拒否する画素数（画像爆弾対策。既定 4000万画素）
IMAGE_MAX_SOURCE_PIXELS=40000000
# 送信前に縮小する長辺（px）と総画素数（ビジュアルトークン＝費用の上限を抑える）
IMAGE_MAX_LONG_EDGE=1568
IMAGE_MAX_PIXELS=1200000
# 正規化済み画像（data/images/）の保存期間（時間）。0 = 回答後すぐ削除
# （0 の場合、同じスレッドの追加質問ではその画像を参照できません）
IMAGE_RETENTION_HOURS=24
# 期限切れ画像の削除を実行する間隔（秒）
IMAGE_CLEANUP_INTERVAL_SEC=600
# メンションと添付が別イベントで届く場合に添付を待つ秒数（メンション質問の応答が最大この秒数遅れる。0 で無効）
IMAGE_EVENT_GRACE_SEC=2

# ---------- Slack 操作 ----------
# 「資料登録」後にファイル添付を待つ時間（分）
UPLOAD_PENDING_MINUTES=10
# 資料一覧の1ページ件数
LIST_PAGE_SIZE=15

# ---------- 運用 ----------
LOG_LEVEL=INFO
# 自動バックアップの保持数・間隔（時間）
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24
# ヘルスチェック用ハートビート間隔（秒）
HEARTBEAT_INTERVAL_SEC=30
# Slack 切断がこの秒数続いたらプロセスを終了し、再起動ポリシーで復旧
SOCKET_DISCONNECT_EXIT_SEC=600
# 再起動時、これより古い未処理の質問は再実行せず失敗通知（分）
QA_JOB_MAX_AGE_MIN=15

# Docker ビルド時に OCR を含めるか（compose のビルド引数）
INSTALL_OCR=false
